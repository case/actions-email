#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

if ! command -v mise >/dev/null 2>&1; then
  echo "Error: mise not found. Install it: https://mise.jdx.dev/getting-started.html" >&2
  exit 1
fi

# Installs only what mise.toml lists and is missing
echo "==> mise install"
mise install

echo
echo "✅ Setup done."
